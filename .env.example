# Copiar a .env en la VM y completar los cuatro IDs. No publicar .env.
INPUT_FOLDER_ID=
PROCESSED_FOLDER_ID=
REVIEW_FOLDER_ID=
SPREADSHEET_ID=
WORKSHEET_NAME=FACTURAS
POLL_SECONDS=60
MIN_TEXT_LENGTH=100
PADDLE_LANG=es
PADDLE_DEVICE=cpu
PADDLE_ENABLE_MKLDNN=false
PADDLE_CPU_THREADS=1
PADDLE_DET_MODEL=PP-OCRv5_mobile_det
PADDLE_REC_MODEL=latin_PP-OCRv5_mobile_rec
PADDLE_REC_BATCH_SIZE=1
PADDLE_DET_LIMIT_SIDE_LEN=1600
PADDLE_MIN_SCORE=0.35
OCR_SCALE=2.0
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=spa
USE_TESSERACT_FALLBACK=true
